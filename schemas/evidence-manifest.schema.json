{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.example/schemas/evidence-manifest.schema.json",
  "title": "MOSAIC Evidence Manifest",
  "type": "object",
  "required": ["sourceCount", "sources", "boundary"],
  "properties": {
    "sourceCount": { "type": "integer", "minimum": 1 },
    "boundary": { "const": "allowlisted_synthetic_sources_only" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "classification",
          "owner",
          "revision",
          "retrievedAt",
          "sourcePath",
          "sha256",
          "facts"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^EVD-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["SYNTHETIC", "PUBLIC-SUMMARY"] },
          "owner": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "retrievedAt": { "type": "string", "pattern": "Z$" },
          "sourcePath": {
            "type": "string",
            "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|(\\.\\.)" }
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "facts": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
