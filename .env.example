# Illustrative offline reference settings; the runtime does not load these variables.
# Enforced boundaries live in source policy, validators and the approved CLI configuration.
MOSAIC_MODE=synthetic
MOSAIC_NETWORK_ACCESS=false
MOSAIC_REAL_CUSTOMER_DATA_ALLOWED=false
MOSAIC_DEFAULT_CONNECTOR_ACCESS=read-only
